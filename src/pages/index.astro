---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import AuroraBackground from "../components/react/AuroraBackground";
import HeroContent from "../components/react/HeroContent";
import TechLogoLoop from "../components/react/TechLogoLoop";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-background text-foreground">
    <Header />

    <section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
      <AuroraBackground
        client:load
        colorStops={['#5227FF', '#7cff67', '#5227FF']}
        amplitude={0.5}
        blend={0.8}
        speed={0.5}
      />

      <HeroContent client:load />
    </section>

    <section class="py-24 px-6 border-t border-border">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-medium text-muted-foreground uppercase tracking-widest text-center mb-12">
          Technologies I Work With
        </h2>
        <TechLogoLoop client:visible />
      </div>
    </section>

    <section class="py-24 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-3 gap-8">
          <a href="/about" class="block p-8 rounded-xl bg-card border border-border hover:border-accent/50 transition-colors">
            <div class="text-accent text-3xl mb-4">&#127909;</div>
            <h3 class="text-xl font-semibold text-foreground mb-3">Talks</h3>
            <p class="text-muted-foreground">
              Conference talks on automation, GitHub Actions, and macOS workflows.
            </p>
          </a>
          <a href="/about" class="block p-8 rounded-xl bg-card border border-border hover:border-accent/50 transition-colors">
            <div class="text-accent-light text-3xl mb-4">&#128187;</div>
            <h3 class="text-xl font-semibold text-foreground mb-3">Open Source</h3>
            <p class="text-muted-foreground">
              Maintainer and contributor work, including munki-manager, munkiMDM, and MunkiReport.
            </p>
          </a>
          <a href="/blog" class="block p-8 rounded-xl bg-card border border-border hover:border-accent/50 transition-colors">
            <div class="text-accent text-3xl mb-4">&#9997;</div>
            <h3 class="text-xl font-semibold text-foreground mb-3">Writing</h3>
            <p class="text-muted-foreground">
              Notes from building internal tools, device management, and automation.
            </p>
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
